<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <add name="FoodDb"
         connectionString="Data Source=localhost;Initial Catalog=CraveCoFoodOrderingDB;Integrated Security=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <pages controlRenderingCompatibilityVersion="4.0" />
    <sessionState mode="InProc" timeout="30" />
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
  </system.webServer>
</configuration>
